# ==============================================================================
# MCP ReAct Agent - Environment Configuration
# ==============================================================================

# LLM Provider: "groq", "gemini", "mistral", or "openai"
# Default provider for this project is "groq" (fast and free tier available)
LLM_PROVIDER=groq

# Model Name:
# - Groq: "qwen/qwen3.8-27b" (recommended for ReAct/MCP tool use) or "openai/gpt-oss-120b"
# - Gemini: "gemini-3.6-flash" or "gemini-1.5-pro"
# - Mistral: "mistral-small-latest" or "mistral-large-latest"
# - OpenAI: "gpt-4o-mini" or "gpt-4o"
LLM_MODEL=qwen/qwen3.8-27b

# Temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# API Keys (Set the one corresponding to your chosen LLM_PROVIDER)
# ------------------------------------------------------------------------------
GROQ_API_KEY=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
GEMINI_API_KEY=AQ.Ab8RN6ICgO79FwXiCzchxsMdsdjXWR0wXLUwmTFzNMdGj_QJ5w
MISTRAL_API_KEY=vTc1VX3YuRbOfvFmONPvS6bnartwEoLb
OPENAI_API_KEY=your-openai-api-key-here

